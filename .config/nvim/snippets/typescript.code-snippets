	},
	"TS Try Catch": {
		"scope": "typescript",
		"prefix": "try",
		"body": [
			"try {",
			"  $2",
			"} catch (error) {",
			"  console.error(`[Error] in $TM_FILENAME_BASE $1: `, error);",
			"}"
		],
		"description": "Basic Try Catch with filename context"
	},
	"TS Server Try Catch (Response)": {
		"scope": "typescript",
		"prefix": "trys",
		"body": [
			"try {",
			"  $2",
			"} catch (error) {",
			"  console.error(`[Error] in $TM_FILENAME_BASE $1: `, error);",
			"  if (res?.headersSent) return;",
			"  return res.status(500).send({",
			"    status: false,",
			"    code: 500,",
			"    detail: `[Error] in $TM_FILENAME_BASE $1`,",
			"    message: 'Internal Server Error',",
			"  });",
			"}"
		],
		"description": "Try Catch that returns a 500 error response"
	},
	"TS Async Function": {
