{
	"TypeScript Singleton Class": {
		"scope": "typescript",
		"prefix": "singleton",
		"body": [
			"export default class ${1:ClassName} {",
			"  // Static Properties",
			"  private static instance: ${1:ClassName};",
			"",
			"  // Readonly Properties",
			"  private readonly serviceName: string = '${1:ClassName}';",
			"",
			"  // Properties",
			"  ${2:private port: number;}",
			"",
			"  private constructor() {",
			"    // Initialization",
			"    console.log('\\x1b[33m%s\\x1b[0m', `[${1:ClassName}] Initialized --------------------`);",
			"    this.initialize();",
			"  }",
			"",
			"  // Static Methods",
			"  public static getInstance(): ${1:ClassName} {",
			"    if (!${1:ClassName}.instance) {",
			"      ${1:ClassName}.instance = new ${1:ClassName}();",
			"    }",
			"    return ${1:ClassName}.instance;",
			"  }",
			"",
			"  // Public Methods",
			"  public ${3:methodName}(): void {",
			"    try {",
			"      $0",
			"    } catch (error) {",
			"      console.error(`[Error] in ${1:ClassName} ${3:methodName}:`, error);",
			"    }",
			"  }",
			"",
			"  // Private Methods",
			"  private initialize(): void {",
			"    // Setup listeners or config",
			"  }",
			"",
			"  // Getters and Setters",
			"  public get ServiceName(): string {",
			"    return this.serviceName;",
			"  }",
			"}"
		],
		"description": "Full Singleton with organized headers"
	},
	"TS Abstract Class": {
		"scope": "typescript",
		"prefix": "abstractc",
		"body": [
			"/**",
			" * Base class for ${1:BaseClassName}",
			" */",
			"export default abstract class ${1:BaseClassName} {",
			"  // Properties",
			"  protected readonly id: string;",
			"",
			"  constructor(id: string) {",
			"    this.id = id;",
			"  }",
			"",
			"  // Abstract Methods",
			"  abstract ${2:execute}(payload: any): Promise<void>;",
			"",
			"  // Protected Methods",
			"  protected log(message: string): void {",
			"    console.log(`[${1:BaseClassName}]: `, ${message});",
			"  }",
			"}"
		],
		"description": "Abstract base class with structure"
	},
	"TS Generic Repository": {
		"scope": "typescript",
		"prefix": "repo",
		"body": [
			"export default class ${1:Repository}<T> {",
			"  // Properties",
			"  private items: Map<string, T> = new Map();",
			"",
			"  // Public Methods",
			"  public add(id: string, item: T): void {",
			"    this.items.set(id, item);",
			"  }",
			"",
			"  public get(id: string): T | undefined {",
			"    return this.items.get(id);",
			"  }",
			"",
			"  public getAll(): T[] {",
			"    return Array.from(this.items.values());",
			"  }",
			"}"
		],
		"description": "Generic class pattern with structure"
	},
	"TS Factory Method": {
		"scope": "typescript",
		"prefix": "factoryc",
		"body": [
			"export default class ${1:FactoryName} {",
			"  // Static Methods",
			"  public static create(type: '${3:TypeA}' | '${5:TypeB}'): ${2:ISomeInterface} {",
			"    switch (type) {",
			"      case '${3:TypeA}':",
			"        return new ${4:ConcreteClassA}();",
			"      case '${5:TypeB}':",
			"        return new ${6:ConcreteClassB}();",
			"      default:",
			"        throw new Error(`Unknown type: ${type}`);",
			"    }",
			"  }",
			"}"
		],
		"description": "Factory pattern with structure"
	},
	"TS Builder Pattern": {
		"scope": "typescript",
		"prefix": "builder",
		"body": [
			"export default class ${1:BuilderName} {",
			"  // Properties",
			"  private data: Partial<${2:TargetClass}> = {};",
			"",
			"  // Public Methods (Setters)",
			"  public setName(name: string): this {",
			"    this.data.name = name;",
			"    return this;",
			"  }",
			"",
			"  public setOptions(opts: any): this {",
			"    this.data.options = opts;",
			"    return this;",
			"  }",
			"",
			"  // Public Methods (Build)",
			"  public build(): ${2:TargetClass} {",
			"    return new ${2:TargetClass}(this.data);",
			"  }",
			"}"
		],
		"description": "Builder pattern with structure"
	},
	"TS Private Field with Accessors": {
		"scope": "typescript",
		"prefix": "prop",
		"body": [
			"  // Properties",
			"  private _${1:propertyName}: ${2:string};",
			"",
			"  // Getters and Setters",
			"  public get ${1:propertyName}(): ${2:string} {",
			"    return this._${1:propertyName};",
			"  }",
			"",
			"  public set ${1:propertyName}(value: ${2:string}) {",
			"    this._${1:propertyName} = value;",
			"  }"
		],
		"description": "Encapsulated property with structure comments"
	},
