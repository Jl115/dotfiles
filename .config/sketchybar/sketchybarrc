#!/usr/bin/env bash

# Just putting some cool icons here:  
# associated_display=active

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
ITEM_DIR="$HOME/.config/sketchybar/items"
FONT="SF Pro"
export NERD_FONT="Hack Nerd Font Mono"
export PADDINGS_SMALL=4
export PADDINGS=8
export PADDINGS_LARGE=16

source "$HOME/.config/sketchybar/colors.sh"
source "$HOME/.config/sketchybar/icons.sh"

##### Bar Appearance #####
bar_config=(
	blur_radius=0
	color=$(get_color BACKGROUND)
	corner_radius=10
	height=34
	margin=10
	notch_width=200
	padding_left=9
	padding_right=7
	position=top
	shadow=on
	topmost=on
	y_offset=5
)

icon_defaults=(
	icon.color="$(get_color FOREGROUND 100)"
	icon.font="$NERD_FONT:Regular:16.0"
	icon.padding_left=$PADDINGS
	icon.padding_right=0
)

label_defaults=(
	label.color="$(get_color FOREGROUND 100)"
	label.font="$FONT:Semibold:13.0"
	label.padding_left=$PADDINGS
	label.padding_right=$PADDINGS
)

background_defaults=(
	background.corner_radius=9
	background.height=30
	background.padding_left="$PADDINGS_LARGE"
	background.padding_right="$PADDINGS_LARGE"
)

popup_defaults=(
	popup.height=30
	popup.horizontal=off
	popup.background.border_color="$(get_color BACKGROUND)"
	popup.background.border_width=2
	popup.background.color="$(get_color BACKGROUND)"
	popup.background.corner_radius=11
	popup.background.shadow.drawing=on
)

# Item styling defaults
item_style=(
	background.corner_radius=12
	background.height=34
	background.color="$(get_color BACKGROUND)"
	background.drawing=on
	background.padding_left=20
	background.padding_right=20
)

# Setting up the general bar appearance and default values
sketchybar --bar "${bar_config[@]}" \
	--default \
	updates=when_shown \
	item_padding=$PADDINGS_LARGE \
	"${icon_defaults[@]}" \
	"${label_defaults[@]}" \
	"${background_defaults[@]}" \
	"${popup_defaults[@]}"

##### Events #####

##### Area Definitions #####
LEFT_AREA=(
	"menu"
	"net"
	"currentuser"
	"app"
)

CENTER_AREA=(
	"datetime"
	"notifs"
	"cpu"
	"public"
)

RIGHT_AREA=(
	"meetings"
	"batt"
	"pkgs"
)

##### Load Items and Create Brackets #####

# --- Left Area ---
for item in "${LEFT_AREA[@]}"; do
	if [ -f "$ITEM_DIR/${item}.sh" ]; then
		source "$ITEM_DIR/${item}.sh"
		add_${item}_item left
	fi
done

sketchybar --add bracket left_bracket "${LEFT_AREA[@]}" \
	--set left_bracket \
	background.color="$(get_color BACKGROUND)" \
	background.corner_radius=12 \
	background.height=34

# --- Center Area ---
for item in "${CENTER_AREA[@]}"; do
	if [ -f "$ITEM_DIR/${item}.sh" ]; then
		source "$ITEM_DIR/${item}.sh"

		if [ "$item" = "cpu" ]; then
			CPU_UPDATE_FREQ=2
			add_${item}_item e # right of notch
		else
			add_${item}_item q # left from notch
		fi
	fi
done

sketchybar --add bracket center_bracket "${CENTER_AREA[@]}" \
	--set center_bracket \
	background.color="$(get_color BACKGROUND)" \
	background.corner_radius=12 \
	background.height=34

# --- Right Area ---
for item in "${RIGHT_AREA[@]}"; do
	if [ -f "$ITEM_DIR/${item}.sh" ]; then
		source "$ITEM_DIR/${item}.sh"
		add_${item}_item right
	fi
done

sketchybar --add bracket right_bracket "${RIGHT_AREA[@]}" \
	--set right_bracket \
	background.color="$(get_color BACKGROUND)" \
	background.corner_radius=12 \
	background.height=34

##### Force all scripts to run the first time #####
sketchybar --update
