layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="APP" focus=true {
        pane split_direction="horizontal" {
            pane command="npm" {
                args "run" "serve"
                cwd "/Users/joelevo/Projects/evosys/floriplan/server"
                focus true
            }
            pane command="npm" {
                args "run" "serve"
                cwd "/Users/joelevo/Projects/evosys/floriplan/client"
            }
        }
    }

    tab name="NVIM" {
        pane cwd="/Users/joelevo/Projects/evosys/floriplan"
    }

    tab name="CONSOLE" {
        pane cwd="/Users/joelevo/Projects/evosys/floriplan"
    }
}
